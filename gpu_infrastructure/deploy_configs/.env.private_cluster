# ==============================================================================
# ENVIRONMENT: PRIVATE GPU CLUSTER
# Dedicated private infrastructure (RTX 4090 / A100 nodes + GPUStack Manager)
# ==============================================================================
ENVIRONMENT=private_gpu_cluster
PORT=5000
DEBUG=false
LOG_LEVEL=INFO

# Primary Trusted Node
PRIMARY_WORKER_PROVIDER=self_hosted
PRIMARY_GPU_MODEL=NVIDIA GeForce RTX 4090
PRIMARY_VRAM_MB=24576
CUDA_VISIBLE_DEVICES=0
USE_CUDA_ACCELERATION=true

# Secondary Cluster Node (GPUStack)
ENABLE_GPUSTACK_INTEGRATION=true
GPUSTACK_ENDPOINT=http://gpustack.cluster.local:80
GPUSTACK_GPU_MODEL=NVIDIA RTX 4090 (Cluster Worker)
GPUSTACK_VRAM_MB=24576

# Security & Community Isolation
ENABLE_COMMUNITY_WORKERS=false
ALLOW_PERSONAL_IMAGES_ON_COMMUNITY=false
REQUIRE_CONTRIBUTOR_CONSENT=true
ZERO_GPU_FALLBACK=false

# Queue & Timeout Handling
MAX_JOB_TIMEOUT_SEC=45
MAX_JOB_RETRIES=2
PROMISE_UNLIMITED_FREE=false
RETURN_503_ON_CAPACITY_LIMIT=true
