# ==============================================================================
# ENVIRONMENT: LOCAL DEVELOPMENT
# Optimized for developers testing the pipeline locally on desktop/laptop.
# ==============================================================================
ENVIRONMENT=local_development
PORT=5000
DEBUG=true
LOG_LEVEL=DEBUG

# Worker Settings
PRIMARY_WORKER_PROVIDER=local_sim
PRIMARY_GPU_MODEL=Local Development Simulator / CPU
PRIMARY_VRAM_MB=8192
USE_CUDA_ACCELERATION=false

# Fallback & Community Settings
ENABLE_SECONDARY_CLOUD_WORKER=false
ENABLE_COMMUNITY_WORKERS=false
ALLOW_PERSONAL_IMAGES_ON_COMMUNITY=false
REQUIRE_CONTRIBUTOR_CONSENT=true
ZERO_GPU_FALLBACK=false

# Queue & Timeout Handling
MAX_JOB_TIMEOUT_SEC=30
MAX_JOB_RETRIES=1
PROMISE_UNLIMITED_FREE=false
RETURN_503_ON_CAPACITY_LIMIT=true
