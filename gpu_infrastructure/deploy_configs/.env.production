# ==============================================================================
# ENVIRONMENT: PRODUCTION COMMERCIAL
# High-Reliability Commercial Infrastructure with SLA & Failover
# ==============================================================================
ENVIRONMENT=production_commercial
PORT=5000
DEBUG=false
LOG_LEVEL=WARNING

# Primary Dedicated GPU (A100 / H100)
PRIMARY_WORKER_PROVIDER=self_hosted
PRIMARY_GPU_MODEL=NVIDIA A100-SXM4-80GB
PRIMARY_VRAM_MB=81920
CUDA_VISIBLE_DEVICES=0,1
USE_CUDA_ACCELERATION=true

# Secondary Dedicated Cloud GPU (RunPod/Lambda Failover)
ENABLE_SECONDARY_CLOUD_WORKER=true
SECONDARY_GPU_ENDPOINT=https://dedicated-gpu-02.internal.soundwave.app
SECONDARY_AUTH_TOKEN_ENV=SOUNDWAVE_GPU_BEARER_KEY
SECONDARY_GPU_MODEL=NVIDIA A10G (Dedicated Cloud)
SECONDARY_VRAM_MB=24000

# Security Boundaries: Hard Community Isolation
ENABLE_COMMUNITY_WORKERS=false
ALLOW_PERSONAL_IMAGES_ON_COMMUNITY=false
REQUIRE_CONTRIBUTOR_CONSENT=true
ZERO_GPU_FALLBACK=false

# Queue, Capacity & Failover SLAs
MAX_JOB_TIMEOUT_SEC=45
MAX_JOB_RETRIES=2
PROMISE_UNLIMITED_FREE=false
RETURN_503_ON_CAPACITY_LIMIT=true
RATE_LIMIT_PER_IP_PER_HOUR=20
