# ==============================================================================
# ENVIRONMENT: COMMUNITY GPU TEST NETWORK
# Heterogeneous P2P / Volunteer GPU Pool (Kalavai)
# STRICT ISOLATION: Only non-sensitive benchmark/test images allowed!
# ==============================================================================
ENVIRONMENT=community_gpu_test_network
PORT=5000
DEBUG=true
LOG_LEVEL=INFO

# Kalavai Pool Integration
ENABLE_COMMUNITY_WORKERS=true
KALAVAI_POOL_ENDPOINT=http://kalavai-pool.internal:8000
ALLOW_PERSONAL_IMAGES_ON_COMMUNITY=false
REQUIRE_CONTRIBUTOR_CONSENT=true

# Fallback Settings
ENABLE_SECONDARY_CLOUD_WORKER=false
ZERO_GPU_FALLBACK=true
HF_ZERO_GPU_SPACE=soundwave/zerogpu-enhancer

# Queue & Timeout Handling
MAX_JOB_TIMEOUT_SEC=60
MAX_JOB_RETRIES=2
PROMISE_UNLIMITED_FREE=false
RETURN_503_ON_CAPACITY_LIMIT=true
